# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，切勿把真实凭证提交到仓库。

# DeepSeek 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ima 官方 Skill 脚本（ima_api.cjs 的绝对路径）
IMA_SKILL_SCRIPT=

# ima 接口凭证
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# ima 共享知识库名称
IMA_KB_NAME=任德耀新建华为PC知识库
