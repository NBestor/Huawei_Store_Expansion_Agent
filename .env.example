# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，切勿把真实凭证提交到仓库。

# DeepSeek 大模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 公网反向代理时填写实际访问源（协议+主机+可选端口，无末尾斜线）；本地留空。
# 例如 http://47.97.59.219，使用域名/HTTPS 时同步修改。
PUBLIC_ORIGIN=

# ima 官方 Skill 脚本（ima_api.cjs 的绝对路径）
IMA_SKILL_SCRIPT=

# ima 接口凭证
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=

# ima 共享知识库名称
IMA_KB_NAME=任德耀新建华为PC知识库
